# Only reviewed public source, tests, scripts, and documentation may be tracked.
/*
!/.gitignore
!/README.md
!/LICENSE
!/build.ps1
!/test.ps1
!/src/
!/tests/
/src/**
/tests/**
!/src/**/
!/tests/**/
!/src/**/*.cs
!/src/**/*.csproj
!/tests/**/*.cs
!/tests/**/*.csproj
!/src/TypeBlocks/Assets/TypeBlocks.ico
!/src/TypeBlocks/Assets/Fonts/Geologica-Light.ttf
!/src/TypeBlocks/Assets/Fonts/OFL.txt

# Runtime data and local build output must never enter Git, even under src/tests.
**/bin/
**/obj/
**/artifacts/
**/.tools/
**/History/
*.tmh
*.tmh.*
vault.json*
settings.json*
*.pdb
*.exe
*.dll
*.zip
*.user
*.suo
